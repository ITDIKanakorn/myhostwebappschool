CREATE OR ALTER PROCEDURE pkgscrwltf001_wltf001a_grid_insert_item_work(
  @piTransactionId      typTransId_Char
  , @piWarehouseCode    typWarehouseCode_Char
  , @piTransferNo       typDocNo_Char
  , @piTransferHeaderId typHeaderId_Char
  , @piUser             typUsername_Char
  , @piPageStart        typCount_Int
  , @piPageLimit        typCount_Int
  , @poTotal            typCount_Int OUTPUT
) AS
/*****************************************************************************
  NAME:      pkgscrwltf001_wltf001a_grid_insert_item_work
  PURPOSE:   Grid item insert work

  REVISIONS:
  Ver.    Date        Author           Description
  ------  ----------  ---------------  --------------------------------------
  1.0     23/11/2022  Piyapat_j.       1. Initial convert this function to SQL Serve.
  1.1     04/01/2023  Piyapat J.       1. Remove Begin Transaction.
  1.2     20/01/2023  thanapon K.      1. Change data type and clear variable.
  1.3     11/07/2023  Paitoon P.       1. Add selected columns to display.
  1.4     22/08/2023  Paitoon P.       1. Dis code wms.pkgwmsstkutil_get_available_stock_out
  1.5     22/08/2023  Paitoon P.       1. Adds wms.pkgwmsstkutil_get_available_stock_out
  1.6     20/02/2024  its-Thaneth J.   1. Adds Manage by Pole/Bill
  1.7     27/02/2024  its-Noppol S.    1. Declare and use varUserLang for function.
*****************************************************************************/
BEGIN
  SET NOCOUNT ON;

  DECLARE @conStockUnitNo typParamNo_BigInt;
  DECLARE @varTotal       typCount_Int;
  DECLARE @varUserLang    typParamEntry_Char;

  SET @conStockUnitNo = 207
  SET @varUserLang = wms.pkgwmslov_find_user_language(@piUser);
  BEGIN TRY
  
  WITH StockOutCTE AS (
    SELECT
        wltd.ltditmid
        , wltd.ltdbatch
        , wms.pkgwmsstkutil_get_available_stock_out(@piWarehouseCode, wltd.ltdsrcstgtyp, wltd.ltdsrcstgbin, wltd.ltditmid, @piTransferNo, NULL, wltd.ltdbatch) AS stkoutdesc
    FROM wltfdtl wltd
    WHERE wltd.ltdhdrid = @piTransferHeaderId
)

    MERGE wltf001a_itm_work AS target
USING (
    SELECT
        @piTransactionId AS itmtranid,
        wltd.ltdseq AS itmseq,
        wltd.ltddtlid AS itmltddtlid,
        wltd.ltdupddat AS itmver,
        wltd.ltditmid AS itmitmid,
        gnl.itmitmcd AS itmitmcd,
        wms.pkgwmsutil_display_by_lang(@varUserLang, gnl.itmedesc, gnl.itmldesc) AS itmitmdesc,
        gnl.itmcapa AS itmitmcapunt,
        pmd.pmdtbdentcd AS itmitmstkun,
        so.stkoutdesc AS itmitmaviqty,
        wltd.ltdsrcstgtyp AS itmsrcstgtypcd,
        wltd.ltdsrcstgbin AS itmsrcstgbin,
        SUM(wltd.ltdqty) AS itmqty,
        wltd.ltdplantyp AS itmplantyp,
        wltd.ltdplanbin AS itmplanbin,
        wltd.ltdputtyp AS itmputtyp,
        wltd.ltdputbin AS itmputbin,
        wgnl.itmbysn AS itmbysn,
        wltd.ltdbatch AS itmbatch,
        wltd.ltdsnno AS itmsnno,
        wltd.ltdpeano AS itmpeano,
        wltd.ltdpoleno AS itmpoleno,
        wltd.ltdnote AS itmnote,
        wltd.ltdreelno AS itmreelno,
        wgnl.itmbypb AS itmprbno
    FROM wltfdtl wltd
    JOIN wltfhdr wlth ON wlth.lthhdrid = wltd.ltdhdrid
    JOIN witmgnl wgnl ON wgnl.itmitmid = wltd.ltditmid
    LEFT JOIN itmgnl gnl ON gnl.itmitmid = wgnl.itmitmid
    LEFT JOIN prmtbldtl pmd ON pmd.pmdtbdtbno = @conStockUnitNo AND pmd.pmdtbdentcd = gnl.itmstkun
    LEFT JOIN StockOutCTE so ON so.ltditmid = wltd.ltditmid AND so.ltdbatch = wltd.ltdbatch
    WHERE wlth.lthwhcd = @piWarehouseCode
      AND wltd.ltdhdrid = @piTransferHeaderId
      AND (wlth.lthtrfno = @piTransferNo OR wlth.lthdocsap = @piTransferNo)
    GROUP BY
        wltd.ltddtlid, wltd.ltdupddat, wltd.ltditmid, gnl.itmitmcd, gnl.itmedesc, gnl.itmldesc,
        gnl.itmcapa, gnl.itmstkun, wltd.ltdsrcstgtyp, wltd.ltdsrcstgbin, wltd.ltdplantyp,
        wltd.ltdplanbin, wltd.ltdputtyp, wltd.ltdputbin, wgnl.itmbysn, pmd.pmdtbdedesc,
        pmd.pmdtbdldesc, wltd.ltdbatch, wltd.ltdsnno, wltd.ltdpeano, wltd.ltdpoleno,
        wltd.ltdnote, wltd.ltdseq, wltd.ltdreelno, wgnl.itmbypb, pmd.pmdtbdentcd, so.stkoutdesc
) AS source
ON target.itmtranid = source.itmtranid
   AND target.itmltddtlid = source.itmltddtlid
   AND target.itmitmid = source.itmitmid
WHEN MATCHED THEN
    UPDATE SET
        target.itmseq = source.itmseq,
        target.itmver = source.itmver,
        target.itmitmcd = source.itmitmcd,
        target.itmitmdesc = source.itmitmdesc,
        target.itmitmcapunt = source.itmitmcapunt,
        target.itmitmstkun = source.itmitmstkun,
        target.itmitmaviqty = source.itmitmaviqty,
        target.itmsrcstgtypcd = source.itmsrcstgtypcd,
        target.itmsrcstgbin = source.itmsrcstgbin,
        target.itmqty = source.itmqty,
        target.itmplantyp = source.itmplantyp,
        target.itmplanbin = source.itmplanbin,
        target.itmputtyp = source.itmputtyp,
        target.itmputbin = source.itmputbin,
        target.itmbysn = source.itmbysn,
        target.itmbatch = source.itmbatch,
        target.itmsnno = source.itmsnno,
        target.itmpeano = source.itmpeano,
        target.itmpoleno = source.itmpoleno,
        target.itmnote = source.itmnote,
        target.itmreelno = source.itmreelno,
        target.itmprbno = source.itmprbno
WHEN NOT MATCHED THEN
    INSERT (
        itmtranid, itmstat, itmdirt, itmchk, itmseq, itmltddtlid, itmver, itmitmid,
        itmitmcd, itmitmdesc, itmitmcapunt, itmitmstkun, itmitmaviqty, itmsrcstgtypcd,
        itmsrcstgbin, itmqty, itmplantyp, itmplanbin, itmputtyp, itmputbin, itmbysn,
        itmbatch, itmsnno, itmpeano, itmpoleno, itmnote, itmreelno, itmprbno
    )
    VALUES (
        source.itmtranid, NULL, NULL, NULL, source.itmseq, source.itmltddtlid, source.itmver,
        source.itmitmid, source.itmitmcd, source.itmitmdesc, source.itmitmcapunt,
        source.itmitmstkun, source.itmitmaviqty, source.itmsrcstgtypcd, source.itmsrcstgbin,
        source.itmqty, source.itmplantyp, source.itmplanbin, source.itmputtyp,
        source.itmputbin, source.itmbysn, source.itmbatch, source.itmsnno, source.itmpeano,
        source.itmpoleno, source.itmnote, source.itmreelno, source.itmprbno
    );
  END TRY

  BEGIN CATCH
    EXEC wms.pkgwmsutil_get_error_message @piUser;
  END CATCH

  EXEC wms.pkgscrwltf001_wltf001a_grid_item_load
    @piTransactionId
    , NULL
    , NULL
    , @piUser
    , @piPageStart
    , @piPageLimit
    , @varTotal OUTPUT

  SET @poTotal = @varTotal;

END;
